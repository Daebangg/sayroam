# --------------------------------------------------------
# MySQL 연결 설정
# --------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3306/sayroam
spring.datasource.username=sayroam
spring.datasource.password=sayroam-local

# --------------------------------------------------------
# Access Token (#30). openssl rand -base64 32 로 생성한 값을 개인 파일에만 입력합니다.
# 키가 없거나 Base64 디코딩 결과가 32바이트 미만이면 앱 시작을 거부합니다.
# --------------------------------------------------------
app.auth.access-token.secret-base64=
app.auth.access-token.issuer=sayroam
app.auth.access-token.audience=sayroam-api
app.auth.access-token.ttl-seconds=900

# Refresh Token의 절대 유효기간과 로그인별 최대 교체 횟수. 갱신으로 만료를 연장하지 않습니다.
app.auth.refresh-token.ttl-seconds=604800
app.auth.refresh-token.max-rotations=10000
# HTTP local 개발 전용. 운영에서는 true(기본값)와 HTTPS를 사용합니다.
app.auth.refresh-cookie.secure=false


# --------------------------------------------------------
# Redis 연결 설정: 포트를 docker/.env의 REDIS_PORT와 맞춥니다 (기본값 6379).
# --------------------------------------------------------
spring.data.redis.host=127.0.0.1
spring.data.redis.port=6379
spring.data.redis.database=0
# 인증이 필요한 Redis 서버를 사용할 때만 아래 항목을 설정합니다.
# spring.data.redis.username=default
# spring.data.redis.password=replace-with-redis-password


# --------------------------------------------------------
# SMTP를 사용하려면 enabled를 true로 바꾸고 아래 설정을 실제 값으로 수정합니다.
# 실제 계정·비밀번호는 이 예시 파일에 넣거나 커밋하지 않습니다.
# 아래는 465 포트의 SSL 예시입니다. 공급자의 설정을 따릅니다.
# --------------------------------------------------------

# false이면 SMTP 설정이 남아 있어도 메일 발송과 시작 시 연결 검사를 비활성화합니다.
app.mail.enabled=false

app.mail.from=no-reply@example.com
spring.mail.host=smtp.example.com
spring.mail.port=465
spring.mail.username=replace-with-smtp-username
spring.mail.password=replace-with-smtp-app-password
spring.mail.properties[mail.smtp.auth]=true
spring.mail.properties[mail.smtp.starttls.enable]=false
spring.mail.properties[mail.smtp.starttls.required]=false
spring.mail.properties[mail.smtp.ssl.enable]=true
spring.mail.properties[mail.smtp.ssl.checkserveridentity]=true

# 연결·읽기·쓰기 timeout은 밀리초 단위입니다 (10초).
spring.mail.properties[mail.smtp.connectiontimeout]=10000
spring.mail.properties[mail.smtp.timeout]=10000
spring.mail.properties[mail.smtp.writetimeout]=10000

# true이면 시작 시 SMTP 연결·인증 실패로 앱 실행이 중단될 수 있습니다.
spring.mail.test-connection=true

# --------------------------------------------------------
# 인증 메일 발급 정책 (시간 단위: 초)
# --------------------------------------------------------
app.auth.email-verification.code-ttl-seconds=300
app.auth.email-verification.resend-cooldown-seconds=60
app.auth.email-verification.rate-window-seconds=3600
app.auth.email-verification.max-requests-per-email=5
app.auth.email-verification.max-requests-per-ip=20
# 발급 요청당 코드 입력 실패 한도와 가입용 증명 유효기간
app.auth.email-verification.max-verification-attempts=5
app.auth.email-verification.signup-proof-ttl-seconds=600

# --------------------------------------------------------
# 계정 관리용 본인 확인 정책 (#30). 가입용 코드·증명과 분리합니다. 시간 단위: 초.
# 비밀번호 변경/탈퇴 목적 간 쿨다운과 회원/IP 발송 횟수는 합산합니다.
# --------------------------------------------------------
app.auth.account-verification.code-ttl-seconds=300
app.auth.account-verification.resend-cooldown-seconds=60
app.auth.account-verification.rate-window-seconds=3600
app.auth.account-verification.max-requests-per-account=5
app.auth.account-verification.max-requests-per-ip=20
app.auth.account-verification.max-verification-attempts=5
app.auth.account-verification.proof-ttl-seconds=600
