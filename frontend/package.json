{
    "name": "@sayroam/frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=24.18.0 <25"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "typecheck": "tsc -b",
        "lint": "eslint . --max-warnings 0",
        "preview": "vite preview",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm typecheck && pnpm lint && pnpm format:check",
        "api:pull": "node scripts/openapi.mts pull",
        "api:generate": "node scripts/openapi.mts generate",
        "api:check": "node scripts/openapi.mts check"
    },
    "dependencies": {
        "i18next": "26.7.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-i18next": "17.1.12"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "10.14.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "globals": "17.13.0",
        "openapi-typescript": "7.13.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vite": "8.3.6"
    }
}
