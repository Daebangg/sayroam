#------------------------------------------
# local 프로필로 실행 중인 백엔드의 명세 주소
#------------------------------------------
OPENAPI_URL=http://localhost:8080/v3/api-docs

#------------------------------------------
# Vite 개발 서버가 API 요청을 전달할 백엔드 주소
#------------------------------------------
API_PROXY_TARGET=http://localhost:8080

#------------------------------------------
# 여행 상세 지도(Google Maps JavaScript API)
# 브라우저 번들에 들어가는 공개 값이다. 사용처 웹사이트를 제한한 키를 쓴다.
# 비워 두면 지도 자리에 안내 문구만 보이고 일정은 그대로 동작한다.
#------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
